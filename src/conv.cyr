# rosnet — 2D/1D convolution with hand-derived gradients (the 1.1 additive).
#
# THE substrate primitive gating the modality axis (sight + hearing) AND the
# Type-4 diffusion reference (agnosticos planning/multimodal-substrate.md +
# generative-paradigms.md) — the last new LEARNED primitive either needed.
#
# Conventions (rosnet contract: flat row-major f64, shapes live in the caller,
# caller-guarantees, no bounds checks):
#   x  (N, Cin, H, W)        input   — index ((n*Cin+ci)*H+ih)*W+iw
#   Wf (Cout, Cin, KH, KW)   filters — index ((co*Cin+ci)*KH+kh)*KW+kw
#   b  (Cout) or 0           bias
#   y  (N, Cout, OH, OW)     output  — Odim = (dim + 2·Pdim − Kdim)/Sdim + 1
# Stride/padding are PER-AXIS (SH,SW / PH,PW ≥ 0, strides ≥ 1) — so the 1D
# wrappers are exact (no phantom padding on the dummy H axis) and audio stems
# can stride along time only.
#
# Backward follows the linear_bwd convention: dx is WRITTEN (zeroed then
# scatter-accumulated internally; pass 0 to skip — e.g. a first layer whose x
# is data), dW/db are ACCUMULATED (caller zeroes once per step). Hand-derived:
#   db[co]           += Σ_{n,oh,ow} dy
#   dW[co,ci,kh,kw]  += Σ_{n,oh,ow} x[n,ci,oh·SH−PH+kh,ow·SW−PW+kw] · dy[n,co,oh,ow]
#   dx[n,ci,ih,iw]   += Σ_{co,kh,kw} Wf[co,ci,kh,kw] · dy[n,co,oh,ow]
#                        (scattered from each dy position — the transpose conv)
# Validated against central finite differences in tests/rosnet.tcyr (the same
# gate linear_bwd carries), incl. stride > 1, padding > 0, non-square kernels.
#
# Implementation: DIRECT convolution loops — correctness-first, deterministic
# accumulation order, no scratch (im2col+matmul / SIMD lanes are the later
# optimization; see docs/benchmarks.md's honest framing).

fn conv2d_out_dim(inn, K, S, P): i64 { return (inn + 2 * P - K) / S + 1; }

# y(N,Cout,OH,OW) = x ⊛ Wf [+ b]; b == 0 means no bias.
fn conv2d_fwd(x, Wf, b, y, N, Cin, H, W, Cout, KH, KW, SH, SW, PH, PW): i64 {
    var OH = conv2d_out_dim(H, KH, SH, PH);
    var OW = conv2d_out_dim(W, KW, SW, PW);
    var n = 0;
    while (n < N) {
        var co = 0;
        while (co < Cout) {
            var oh = 0;
            while (oh < OH) {
                var ow = 0;
                while (ow < OW) {
                    var acc = f64_from(0);
                    if (b != 0) { acc = load64(b + co * 8); }
                    var ci = 0;
                    while (ci < Cin) {
                        var kh = 0;
                        while (kh < KH) {
                            var ih = oh * SH - PH + kh;
                            if (ih >= 0) { if (ih < H) {
                                    var kw = 0;
                                    while (kw < KW) {
                                        var iw = ow * SW - PW + kw;
                                        if (iw >= 0) { if (iw < W) {
                                                var xv = load64(x + (((n * Cin + ci) * H + ih) * W + iw) * 8);
                                                var wv = load64(Wf + (((co * Cin + ci) * KH + kh) * KW + kw) * 8);
                                                acc = f64_add(acc, f64_mul(xv, wv));
                                            } }
                                        kw = kw + 1;
                                    }
                                } }
                            kh = kh + 1;
                        }
                        ci = ci + 1;
                    }
                    store64(y + (((n * Cout + co) * OH + oh) * OW + ow) * 8, acc);
                    ow = ow + 1;
                }
                oh = oh + 1;
            }
            co = co + 1;
        }
        n = n + 1;
    }
    return 0;
}

# Given dy(N,Cout,OH,OW): write dx(N,Cin,H,W); accumulate dW(Cout,Cin,KH,KW),
# db(Cout). db may be 0 (no bias grad); dx may be 0 (skip the input gradient).
fn conv2d_bwd(x, Wf, dy, dx, dW, db, N, Cin, H, W, Cout, KH, KW, SH, SW, PH, PW): i64 {
    var OH = conv2d_out_dim(H, KH, SH, PH);
    var OW = conv2d_out_dim(W, KW, SW, PW);
    if (dx != 0) { t_zero(dx, N * Cin * H * W); }
    var n = 0;
    while (n < N) {
        var co = 0;
        while (co < Cout) {
            var oh = 0;
            while (oh < OH) {
                var ow = 0;
                while (ow < OW) {
                    var g = load64(dy + (((n * Cout + co) * OH + oh) * OW + ow) * 8);
                    if (db != 0) {
                        store64(db + co * 8, f64_add(load64(db + co * 8), g));
                    }
                    var ci = 0;
                    while (ci < Cin) {
                        var kh = 0;
                        while (kh < KH) {
                            var ih = oh * SH - PH + kh;
                            if (ih >= 0) { if (ih < H) {
                                    var kw = 0;
                                    while (kw < KW) {
                                        var iw = ow * SW - PW + kw;
                                        if (iw >= 0) { if (iw < W) {
                                                var xi = (((n * Cin + ci) * H + ih) * W + iw) * 8;
                                                var wi = (((co * Cin + ci) * KH + kh) * KW + kw) * 8;
                                                store64(dW + wi,
                                                  f64_add(load64(dW + wi), f64_mul(load64(x + xi), g)));
                                                if (dx != 0) {
                                                    store64(dx + xi,
                                                      f64_add(load64(dx + xi), f64_mul(load64(Wf + wi), g)));
                                                }
                                            } }
                                        kw = kw + 1;
                                    }
                                } }
                            kh = kh + 1;
                        }
                        ci = ci + 1;
                    }
                    ow = ow + 1;
                }
                oh = oh + 1;
            }
            co = co + 1;
        }
        n = n + 1;
    }
    return 0;
}

# ---- conv1d: the H=1 specialization (audio stems, sequence convs) ------------
# x(N,Cin,L), Wf(Cout,Cin,K), y(N,Cout,OL) — exact wrappers over conv2d with
# H = KH = 1 and NO padding/stride on the dummy axis (bit-identical to the 2D
# path by construction).
fn conv1d_fwd(x, Wf, b, y, N, Cin, L, Cout, K, S, P): i64 {
    return conv2d_fwd(x, Wf, b, y, N, Cin, 1, L, Cout, 1, K, 1, S, 0, P);
}

fn conv1d_bwd(x, Wf, dy, dx, dW, db, N, Cin, L, Cout, K, S, P): i64 {
    return conv2d_bwd(x, Wf, dy, dx, dW, db, N, Cin, 1, L, Cout, 1, K, 1, S, 0, P);
}
