# rosnet GPU profile — host-side tests (no device needed).
#
# src/gpu.cyr cannot dispatch without an AMD device, but everything it does on
# the host before a dispatch can run anywhere: the shader-cache bookkeeping, the
# cache-key field checks, and the SPIR-V builders. These pin the 1.2.2 repairs:
#   - every builder fits its caller's fn-local `var spv[8192]` (8,192 BYTES) at
#     the largest parameters that entry point's guards allow — before 1.2.2,
#     gpu_attn_core had no hd cap and the scores builder wrote 11,172 bytes at
#     hd = 64, past the end of that stack buffer;
#   - a full cache answers -1 ("do not compile") instead of 0, so a module that
#     cannot be cached is never built and leaked;
#   - _gpu_kfit refuses values that would overflow a key field.
include "lib/mabda.cyr"
include "lib/result.cyr"
include "lib/ganita.cyr"
include "src/gpu.cyr"

var BUF = 0;
var BUFSZ = 65536;

fn clr(): i64 {
    var i = 0;
    while (i < BUFSZ) { store64(BUF + i, 0); i = i + 8; }
    return 0;
}

# Builder output size in bytes must fit spv[8192].
fn fits(name, nbytes): i64 {
    assert(nbytes > 0, name);
    assert(nbytes <= 8192, name);
    return 0;
}

fn main() {
    alloc_init();
    BUF = alloc(BUFSZ);
    var sc = f64_div(f64_from(1), f64_sqrt(f64_from(32)));
    var tk = GPU_TK();

    test_group("key fields");
    assert(_gpu_kfit(0, 14) == 1, "0 fits");
    assert(_gpu_kfit(16383, 14) == 1, "2^14 - 1 fits 14 bits");
    assert(_gpu_kfit(16384, 14) == 0, "2^14 does not fit 14 bits");
    assert(_gpu_kfit(0 - 1, 14) == 0, "negative never fits");
    assert(_gpu_kfit(1, 1) == 1, "dir 1 fits 1 bit");
    assert(_gpu_kfit(2, 1) == 0, "dir 2 does not fit 1 bit");

    test_group("shader cache");
    assert(_GPU_CACHE_CAP() == 1024, "capacity = the 1024 slots the arrays hold");
    var saved = _gpu_cn;
    assert(_gpu_cache_get(77) == 0, "miss on a non-full cache = 0 (compile)");
    _gpu_cache_put(77, 5);
    assert(_gpu_cache_get(77) == 5, "hit returns the handle");
    _gpu_cache_put(78, 0 - 1);
    assert(_gpu_cache_get(78) == (0 - 1), "a cached compile-fail stays -1");
    var k = _gpu_cn;
    while (k < _GPU_CACHE_CAP()) { _gpu_cache_put(1000 + k, 9); k = k + 1; }
    assert(_gpu_cn == _GPU_CACHE_CAP(), "fills to capacity");
    assert(_gpu_cache_get(77) == 5, "hits still served when full");
    # 1.3.0: a full cache is a soft limit — the miss still compiles, the module
    # is tracked as a transient and released after its one dispatch
    assert(_gpu_cache_get(424242) == 0, "miss on a FULL cache = 0 (compile anyway)");
    assert(_gpu_cache_keep(424242, 31) == 31, "keep on a full cache hands the module back");
    assert(_gpu_cn == _GPU_CACHE_CAP(), "... without caching it");
    assert(_gpu_trn == 1, "... tracked as a transient");
    assert(_gpu_cache_get(424242) == 0, "a transient is never a cache hit");
    assert(_gpu_release_if_transient(5) == 0, "a cached module is not released");
    assert(_gpu_release_if_transient(31) == 1, "the transient is released");
    assert(_gpu_trn == 0, "... and untracked");
    var t = 0;
    while (t < _GPU_TR_CAP()) { _gpu_cache_keep(500000 + t, 100 + t); t = t + 1; }
    assert(_gpu_cache_keep(600000, 200) == 0, "no transient slot left: released, CPU fallback");
    while (_gpu_trn > 0) { _gpu_release_if_transient(load64(&_gpu_tr)); }
    _gpu_cn = saved;

    test_group("dispatch failure is sticky");
    # no device context here, so mabda's dispatch fails (GPU_ERR_OTHER) — the
    # stand-in for a device that stops answering mid-run
    var st0 = _gpu_state;
    _gpu_state = 1;
    _gpu_cache_keep(700000, 41);                       # (cache has room: cached, not transient)
    _gpu_cn = _GPU_CACHE_CAP();
    _gpu_cache_keep(700001, 42);                       # a transient
    var bp[16]; store64(&bp, 0);
    assert(_gpu_dispatch(42, 1, &bp) != 0, "a failing dispatch returns mabda's error");
    assert(_gpu_state == 2, "... and marks the GPU unavailable");
    assert(_gpu_init() == 0, "every later entry falls back at once");
    assert(_gpu_trn == 0, "a failed dispatch still releases its transient");
    _gpu_state = st0;
    _gpu_cn = saved;

    test_group("builders fit spv[8192] at their guard limits");
    clr(); fits("tile TK=16", _gpu_build_tile(BUF, 768, 768, 0, tk));
    clr(); fits("tile_t TK=16", _gpu_build_tile_t(BUF, 768, 50257, 0, tk));
    clr(); fits("tile_dw TK=16", _gpu_build_tile_dw(BUF, 768, 768, 0, tk));
    clr(); fits("ln mean TK=16", _gpu_build_mean(BUF, 768, 0, tk));
    clr(); fits("ln var TK=16", _gpu_build_var(BUF, 768, 0, tk));
    clr(); fits("ln norm", _gpu_build_norm(BUF, 768));
    clr(); fits("gelu", _gpu_build_gelu(BUF));
    clr(); fits("gelu_bwd", _gpu_build_gelu_bwd(BUF));
    clr(); fits("lnbwd_red TK=8", _gpu_build_lnbwd_red(BUF, 768, 0, 64, 8));
    clr(); fits("lnbwd_param TK=8", _gpu_build_lnbwd_param(BUF, 768, 0, 64, 8));
    clr(); fits("lnbwd_dx", _gpu_build_lnbwd_dx(BUF, 768, 64));
    # dp and scores are tiled over hd (1.4.0): the entries build at most _GPU_ATTN_TD()
    # products per kernel, so check the worst tiles at the largest hd the key allows (127)
    clr(); fits("abwd_dp tile d0=0 td=8, hd 127", _gpu_build_abwd_dp_t(BUF, 64, 1016, 127, 0, 8));
    clr(); fits("abwd_dp tile d0=112 td=8, hd 127", _gpu_build_abwd_dp_t(BUF, 64, 1016, 127, 112, 8));
    clr(); fits("abwd_dp last tile d0=120 td=7, hd 127", _gpu_build_abwd_dp_t(BUF, 64, 1016, 127, 120, 7));
    clr(); fits("abwd_sds", _gpu_build_abwd_sds(BUF, 64, sc));
    clr(); fits("abwd_dot_t tk=16", _gpu_build_abwd_dot_t(BUF, 64, 0, 16));
    clr(); fits("abwd_dq_t hd=32 tk=16", _gpu_build_abwd_dq_t(BUF, 64, 1024, 32, 0, 16));
    clr(); fits("abwd_gather_t hd=32 tk=16", _gpu_build_abwd_gather_t(BUF, 64, 1024, 32, 0, 16));
    clr(); fits("attn_scores tile d0=0 td=8, hd 127", _gpu_attn_scores_t(BUF, 64, 1016, 127, 1016, sc, 0, 8));
    clr(); fits("attn_scores tile d0=112 td=8, hd 127", _gpu_attn_scores_t(BUF, 64, 1016, 127, 1016, sc, 112, 8));
    clr(); fits("attn_scores last tile d0=120 td=7, hd 127", _gpu_attn_scores_t(BUF, 64, 1016, 127, 1016, sc, 120, 7));
    assert(_GPU_ATTN_TD() <= 8, "the hd tile stays at most 8 (what compiles under mabda's id cap)");
    clr(); fits("attn_rowmax TK", _gpu_attn_rowmax(BUF, 64, 0, _GPU_ATTN_TK()));
    clr(); fits("attn_expsum TK", _gpu_attn_expsum(BUF, 64, 0, _GPU_ATTN_TK()));
    clr(); fits("attn_pv hd=32 TK", _gpu_attn_pv(BUF, 64, 1024, 32, 1024, 0, _GPU_ATTN_TK()));
    clr(); fits("adam", _gpu_adam_k(BUF, 0));
    clr(); fits("rope", _gpu_build_rope(BUF, 768, 64, 32, 12, 1));
    # why the hd loops are tiled (and why 1.2.2 capped hd at 32): untiled, they outgrow the buffer
    clr(); assert(_gpu_attn_scores(BUF, 64, 768, 64, 768, sc) > 8192, "scores at hd=64 would overflow spv[8192]");
    clr(); assert(_gpu_build_abwd_dp(BUF, 64, 768, 64) > 8192, "abwd_dp at hd=64 would overflow spv[8192]");

    return assert_summary();
}

var exit_code = main();
syscall(SYS_EXIT, exit_code);
