# rosnet benchmarks — the v1.0 capture set (docs/benchmarks.md holds the numbers).
# Stdlib auto-included via cyrius.cyml.
#
# Pattern: bench_new -> bench_batch_start -> tight loop -> bench_batch_stop -> bench_report.
# For sub-1us ops use batch_size >= 1000 to amortize clock_gettime overhead
# (~240 ns per start/stop pair on x86_64 Linux). See lib/bench.cyr header for
# the full overhead-vs-batching guidance.
#
# Shapes are the substrate's real consumer shapes:
#   - BLAS-1 over 768 (one transformer channel row): axpy, scale, add_into, sum,
#     copy; and the 768x768 zero a training step pays to reset dW
#   - linear_fwd 64x768x768   (a GPT-2-small attention/MLP projection, T=64)
#   - linear_fwd 1x768x12564  (a quarter of the weight-tied LM head, one decode row)
#   - linear_bwd 64x768x768   (the gradient pair of the projection)
#   - conv2d 8x8x28x28 -> 8, 3x3 pad 1 (an MNIST-class hidden layer), fwd + bwd
#   - conv1d 4x16x1024 -> 16, K=5 pad 2 (an audio stem), fwd + bwd
# Labels are kept stable across releases: scripts/bench-history.sh keys
# bench-history.csv rows on them.
include "src/tensor.cyr"
include "src/linear.cyr"
include "src/conv.cyr"

fn bench_axpy_768(): i64 {
    var n = 768;
    var dst = t_alloc(n);
    var src = t_alloc(n);
    t_fill(dst, n, ff(1));
    t_fill(src, n, ff(2));
    var a = f64_div(ff(1), ff(3));
    var b = bench_new("t_axpy n=768");
    bench_batch_start(b);
    var i = 0;
    while (i < 100000) { t_axpy(dst, src, a, n); i = i + 1; }
    bench_batch_stop(b, 100000);
    bench_report(b);
    return 0;
}

# The other BLAS-1 ops at the same channel-row length, and the bulk zero a
# training step pays to reset a 768x768 dW.
fn bench_blas1_768(): i64 {
    var n = 768;
    var dst = t_alloc(n);
    var src = t_alloc(n);
    t_fill(dst, n, ff(1));
    t_fill(src, n, f64_div(ff(1), ff(3)));
    var s = f64_div(ff(9), ff(10));
    var b = bench_new("t_scale n=768");
    bench_batch_start(b);
    var i = 0;
    while (i < 100000) { t_scale(dst, n, s); i = i + 1; }
    bench_batch_stop(b, 100000);
    bench_report(b);
    t_fill(dst, n, ff(1));
    var b2 = bench_new("t_add_into n=768");
    bench_batch_start(b2);
    i = 0;
    while (i < 100000) { t_add_into(dst, src, n); i = i + 1; }
    bench_batch_stop(b2, 100000);
    bench_report(b2);
    var acc = 0;
    var b3 = bench_new("t_sum n=768");
    bench_batch_start(b3);
    i = 0;
    while (i < 100000) { acc = acc ^ t_sum(src, n); i = i + 1; }
    bench_batch_stop(b3, 100000);
    bench_report(b3);
    var b4 = bench_new("t_copy n=768");
    bench_batch_start(b4);
    i = 0;
    while (i < 100000) { t_copy(dst, src, n); i = i + 1; }
    bench_batch_stop(b4, 100000);
    bench_report(b4);
    var big = t_alloc(768 * 768);
    var b5 = bench_new("t_zero n=768x768");
    bench_batch_start(b5);
    i = 0;
    while (i < 100) { t_zero(big, 768 * 768); i = i + 1; }
    bench_batch_stop(b5, 100);
    bench_report(b5);
    return acc;
}

fn bench_linear_fwd_proj(): i64 {
    var M = 64;
    var K = 768;
    var N = 768;
    var x = t_alloc(M * K);
    var W = t_alloc(K * N);
    var bb = t_alloc(N);
    var y = t_alloc(M * N);
    t_fill(x, M * K, f64_div(ff(1), ff(7)));
    t_fill(W, K * N, f64_div(ff(1), ff(11)));
    t_fill(bb, N, f64_div(ff(1), ff(13)));
    var b = bench_new("linear_fwd 64x768x768");
    bench_batch_start(b);
    var i = 0;
    while (i < 10) { linear_fwd(x, W, bb, y, M, K, N); i = i + 1; }
    bench_batch_stop(b, 10);
    bench_report(b);
    return 0;
}

fn bench_linear_fwd_head(): i64 {
    # 1/4 of the GPT-2 LM head (full 768x50257 W = 309 MB f64, past the 256 MB
    # alloc cap) — scale the avg x4 for the full weight-tied head row.
    var M = 1;
    var K = 768;
    var N = 12564;
    var x = t_alloc(M * K);
    var W = t_alloc(K * N);
    var y = t_alloc(M * N);
    t_fill(x, M * K, f64_div(ff(1), ff(7)));
    t_fill(W, K * N, f64_div(ff(1), ff(11)));
    var b = bench_new("linear_fwd 1x768x12564 (1/4 LM head row)");
    bench_batch_start(b);
    var i = 0;
    while (i < 10) { linear_fwd(x, W, 0, y, M, K, N); i = i + 1; }
    bench_batch_stop(b, 10);
    bench_report(b);
    return 0;
}

fn bench_linear_bwd_proj(): i64 {
    var M = 64;
    var K = 768;
    var N = 768;
    var x = t_alloc(M * K);
    var W = t_alloc(K * N);
    var dy = t_alloc(M * N);
    var dx = t_alloc(M * K);
    var dW = t_alloc(K * N);
    var db = t_alloc(N);
    t_fill(x, M * K, f64_div(ff(1), ff(7)));
    t_fill(W, K * N, f64_div(ff(1), ff(11)));
    t_fill(dy, M * N, f64_div(ff(1), ff(5)));
    var b = bench_new("linear_bwd 64x768x768");
    bench_batch_start(b);
    var i = 0;
    while (i < 10) {
        t_zero(dW, K * N);
        t_zero(db, N);
        linear_bwd(x, W, dy, dx, dW, db, M, K, N);
        i = i + 1;
    }
    bench_batch_stop(b, 10);
    bench_report(b);
    return 0;
}

fn bench_conv2d(): i64 {
    # an MNIST-class hidden conv layer: 8x8x28x28 -> 8, 3x3, stride 1, pad 1
    var N = 8; var Cin = 8; var H = 28; var W = 28;
    var Cout = 8; var K = 3;
    var x = t_alloc(N * Cin * H * W);
    var Wf = t_alloc(Cout * Cin * K * K);
    var b = t_alloc(Cout);
    var y = t_alloc(N * Cout * H * W);
    t_fill(x, N * Cin * H * W, f64_div(ff(1), ff(7)));
    t_fill(Wf, Cout * Cin * K * K, f64_div(ff(1), ff(11)));
    var bh = bench_new("conv2d_fwd 8x8x28x28 -> 8 (3x3, pad 1)");
    bench_batch_start(bh);
    var i = 0;
    while (i < 10) { conv2d_fwd(x, Wf, b, y, N, Cin, H, W, Cout, K, K, 1, 1, 1, 1); i = i + 1; }
    bench_batch_stop(bh, 10);
    bench_report(bh);
    var dx = t_alloc(N * Cin * H * W);
    var dW = t_alloc(Cout * Cin * K * K);
    var db = t_alloc(Cout);
    var bh2 = bench_new("conv2d_bwd same shape");
    bench_batch_start(bh2);
    i = 0;
    while (i < 10) {
        t_zero(dW, Cout * Cin * K * K);
        t_zero(db, Cout);
        conv2d_bwd(x, Wf, y, dx, dW, db, N, Cin, H, W, Cout, K, K, 1, 1, 1, 1);
        i = i + 1;
    }
    bench_batch_stop(bh2, 10);
    bench_report(bh2);
    # the same layer at stride 2 (a downsampling conv): SW > 1 takes its own path
    var y2 = t_alloc(N * Cout * 14 * 14);
    var bh3 = bench_new("conv2d_fwd stride 2 (8x8x28x28 -> 8, 3x3, pad 1)");
    bench_batch_start(bh3);
    i = 0;
    while (i < 10) { conv2d_fwd(x, Wf, b, y2, N, Cin, H, W, Cout, K, K, 2, 2, 1, 1); i = i + 1; }
    bench_batch_stop(bh3, 10);
    bench_report(bh3);
    return 0;
}

fn bench_conv1d(): i64 {
    # an audio-stem conv: 4x16x1024 -> 16, K=5, stride 1, pad 2
    var N = 4; var Cin = 16; var L = 1024; var Cout = 16; var K = 5;
    var x = t_alloc(N * Cin * L);
    var Wf = t_alloc(Cout * Cin * K);
    var b = t_alloc(Cout);
    var y = t_alloc(N * Cout * L);
    t_fill(x, N * Cin * L, f64_div(ff(1), ff(7)));
    t_fill(Wf, Cout * Cin * K, f64_div(ff(1), ff(11)));
    var bh = bench_new("conv1d_fwd 4x16x1024 -> 16 (K=5, pad 2)");
    bench_batch_start(bh);
    var i = 0;
    while (i < 10) { conv1d_fwd(x, Wf, b, y, N, Cin, L, Cout, K, 1, 2); i = i + 1; }
    bench_batch_stop(bh, 10);
    bench_report(bh);
    var dx = t_alloc(N * Cin * L);
    var dW = t_alloc(Cout * Cin * K);
    var db = t_alloc(Cout);
    var bh2 = bench_new("conv1d_bwd same shape");
    bench_batch_start(bh2);
    i = 0;
    while (i < 10) {
        t_zero(dW, Cout * Cin * K);
        t_zero(db, Cout);
        conv1d_bwd(x, Wf, y, dx, dW, db, N, Cin, L, Cout, K, 1, 2);
        i = i + 1;
    }
    bench_batch_stop(bh2, 10);
    bench_report(bh2);
    return 0;
}

# A mixed "training step": every hot op once per step, timed end to end. Per-op
# rows can mislead on a power-limited CPU — 256-bit AVX2 work lowers the clock for
# whatever runs next — so this row is the one that says whether a change made a
# real workload faster (1.4.1).
fn bench_step(): i64 {
    var M = 64; var K = 768; var N = 768;
    var x = t_alloc(M * K); var W = t_alloc(K * N); var b = t_alloc(N); var y = t_alloc(M * N);
    var dy = t_alloc(M * N); var dx = t_alloc(M * K); var dW = t_alloc(K * N); var db = t_alloc(N);
    t_fill(x, M * K, f64_div(ff(1), ff(7))); t_fill(W, K * N, f64_div(ff(1), ff(11)));
    t_fill(dy, M * N, f64_div(ff(1), ff(5)));
    var cN = 8; var Ci = 8; var H = 28; var Wd = 28; var Co = 8; var KK = 3;
    var cx = t_alloc(cN * Ci * H * Wd); var cw = t_alloc(Co * Ci * KK * KK); var cb = t_alloc(Co);
    var cy = t_alloc(cN * Co * H * Wd); var cdx = t_alloc(cN * Ci * H * Wd);
    var cdw = t_alloc(Co * Ci * KK * KK); var cdb = t_alloc(Co);
    t_fill(cx, cN * Ci * H * Wd, f64_div(ff(1), ff(7))); t_fill(cw, Co * Ci * KK * KK, f64_div(ff(1), ff(11)));
    var lr = f64_div(ff(1), ff(1000));
    var bh = bench_new("training step (linear fwd+bwd, conv fwd+bwd, SGD update)");
    bench_batch_start(bh);
    var s = 0;
    while (s < 8) {
        linear_fwd(x, W, b, y, M, K, N);
        t_zero(dW, K * N); t_zero(db, N);
        linear_bwd(x, W, dy, dx, dW, db, M, K, N);
        conv2d_fwd(cx, cw, cb, cy, cN, Ci, H, Wd, Co, KK, KK, 1, 1, 1, 1);
        t_zero(cdw, Co * Ci * KK * KK); t_zero(cdb, Co);
        conv2d_bwd(cx, cw, cy, cdx, cdw, cdb, cN, Ci, H, Wd, Co, KK, KK, 1, 1, 1, 1);
        t_scale(dW, K * N, lr);
        t_add_into(W, dW, K * N);
        s = s + 1;
    }
    bench_batch_stop(bh, 8);
    bench_report(bh);
    return 0;
}

fn main(): i64 {
    alloc_init();
    bench_axpy_768();
    bench_blas1_768();
    bench_linear_fwd_proj();
    bench_linear_fwd_head();
    bench_linear_bwd_proj();
    bench_conv2d();
    bench_conv1d();
    bench_step();
    return 0;
}

var r = main();
syscall(SYS_EXIT, r);
