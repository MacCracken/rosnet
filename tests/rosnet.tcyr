# rosnet test suite — finite-difference gradient checks + exact BLAS-1 ops.
#
# A hand-derived backward is only as trustworthy as its grad-check. linear_bwd
# is verified against CENTRAL finite differences of linear_fwd — the same check
# attn11 uses, ported here as rosnet's correctness gate. Stdlib (assert/math)
# auto-included; rng_seed/rng_normal come from the tyche dep (lib/tyche.cyr
# appears after `cyrius deps`).
include "lib/tyche.cyr"
include "src/tensor.cyr"
include "src/linear.cyr"
include "src/conv.cyr"
include "tests/reference.cyr"

fn _eps(): i64 { return f64_div(f64_from(1), f64_from(10000)); }     # 1e-4

fn dotsum(a, b, n): i64 {
    var acc = f64_from(0); var i = 0;
    while (i < n) { acc = f64_add(acc, f64_mul(load64(a + i * 8), load64(b + i * 8))); i = i + 1; }
    return acc;
}

# max relative error between analytic and numeric gradient arrays
fn maxrel(analytic, numeric, n): i64 {
    var mr = f64_from(0);
    var tiny = f64_div(f64_from(1), f64_from(1000000000));
    var i = 0;
    while (i < n) {
        var a = load64(analytic + i * 8); var b = load64(numeric + i * 8);
        var rel = f64_div(f64_abs(f64_sub(a, b)),
          f64_add(f64_add(f64_abs(a), f64_abs(b)), tiny));
        if (f64_gt(rel, mr) == 1) { mr = rel; }
        i = i + 1;
    }
    return mr;
}

# assert max-rel-err < 1/tol_inv
fn check(name, analytic, numeric, n, tol_inv): i64 {
    var mr = maxrel(analytic, numeric, n);
    assert(f64_lt(mr, f64_div(f64_from(1), f64_from(tol_inv))) == 1, name);
    return 0;
}

fn lin_loss(x, W, b, y, dy, M, K, N): i64 {
    linear_fwd(x, W, b, y, M, K, N);
    return dotsum(dy, y, M * N);
}

# conv scalar loss: y = conv2d(x, Wf) + b ; L = <dy, y>  (dL/dy = dy exactly)
fn conv_loss(x, Wf, b, y, dy, N, Cin, H, W, Cout, KH, KW, SH, SW, PH, PW): i64 {
    conv2d_fwd(x, Wf, b, y, N, Cin, H, W, Cout, KH, KW, SH, SW, PH, PW);
    var OH = conv2d_out_dim(H, KH, SH, PH);
    var OW = conv2d_out_dim(W, KW, SW, PW);
    return dotsum(dy, y, N * Cout * OH * OW);
}

# FD-gate one conv2d configuration end-to-end (dx, dW, db vs central diffs)
fn conv_fd_case(name, N, Cin, H, W, Cout, KH, KW, SH, SW, PH, PW): i64 {
    var OH = conv2d_out_dim(H, KH, SH, PH);
    var OW = conv2d_out_dim(W, KW, SW, PW);
    var x = t_alloc(N * Cin * H * W);
    var Wf = t_alloc(Cout * Cin * KH * KW);
    var b = t_alloc(Cout);
    var y = t_alloc(N * Cout * OH * OW);
    var dy = t_alloc(N * Cout * OH * OW);
    t_randn(x, N * Cin * H * W, f64_from(1));
    t_randn(Wf, Cout * Cin * KH * KW, f64_from(1));
    t_randn(b, Cout, f64_from(1));
    t_randn(dy, N * Cout * OH * OW, f64_from(1));
    var dx = t_alloc(N * Cin * H * W);
    var dW = t_alloc(Cout * Cin * KH * KW);
    var db = t_alloc(Cout);
    conv2d_bwd(x, Wf, dy, dx, dW, db, N, Cin, H, W, Cout, KH, KW, SH, SW, PH, PW);
    var eps = _eps(); var te = f64_mul(f64_from(2), eps);
    var nx = N * Cin * H * W;
    var ndx = t_alloc(nx); var i = 0;
    while (i < nx) {
        var o = load64(x + i * 8);
        store64(x + i * 8, f64_add(o, eps));
        var lp = conv_loss(x, Wf, b, y, dy, N, Cin, H, W, Cout, KH, KW, SH, SW, PH, PW);
        store64(x + i * 8, f64_sub(o, eps));
        var lm = conv_loss(x, Wf, b, y, dy, N, Cin, H, W, Cout, KH, KW, SH, SW, PH, PW);
        store64(x + i * 8, o); store64(ndx + i * 8, f64_div(f64_sub(lp, lm), te)); i = i + 1;
    }
    var nw = Cout * Cin * KH * KW;
    var ndW = t_alloc(nw); i = 0;
    while (i < nw) {
        var o = load64(Wf + i * 8);
        store64(Wf + i * 8, f64_add(o, eps));
        var lp = conv_loss(x, Wf, b, y, dy, N, Cin, H, W, Cout, KH, KW, SH, SW, PH, PW);
        store64(Wf + i * 8, f64_sub(o, eps));
        var lm = conv_loss(x, Wf, b, y, dy, N, Cin, H, W, Cout, KH, KW, SH, SW, PH, PW);
        store64(Wf + i * 8, o); store64(ndW + i * 8, f64_div(f64_sub(lp, lm), te)); i = i + 1;
    }
    var ndb = t_alloc(Cout); i = 0;
    while (i < Cout) {
        var o = load64(b + i * 8);
        store64(b + i * 8, f64_add(o, eps));
        var lp = conv_loss(x, Wf, b, y, dy, N, Cin, H, W, Cout, KH, KW, SH, SW, PH, PW);
        store64(b + i * 8, f64_sub(o, eps));
        var lm = conv_loss(x, Wf, b, y, dy, N, Cin, H, W, Cout, KH, KW, SH, SW, PH, PW);
        store64(b + i * 8, o); store64(ndb + i * 8, f64_div(f64_sub(lp, lm), te)); i = i + 1;
    }
    var nm = str_builder_new();
    str_builder_add_cstr(nm, name); str_builder_add_cstr(nm, " dx");
    check(str_cstr(str_builder_build(nm)), dx, ndx, nx, 100000);
    var nm2 = str_builder_new();
    str_builder_add_cstr(nm2, name); str_builder_add_cstr(nm2, " dW");
    check(str_cstr(str_builder_build(nm2)), dW, ndW, nw, 100000);
    var nm3 = str_builder_new();
    str_builder_add_cstr(nm3, name); str_builder_add_cstr(nm3, " db");
    check(str_cstr(str_builder_build(nm3)), db, ndb, Cout, 100000);
    return 0;
}

fn main() {
    alloc_init();
    rng_seed(1234);

    # ---- BLAS-1: exact, integer-valued so bit-patterns compare directly ----
    test_group("blas1");
    var v = t_alloc(4);
    t_fill(v, 4, f64_from(2));                  # [2,2,2,2]
    assert_eq(t_sum(v, 4), f64_from(8), "t_sum after fill");
    t_scale(v, 4, f64_from(3));                 # [6,6,6,6]
    assert_eq(t_sum(v, 4), f64_from(24), "t_scale x3");
    var w = t_alloc(4);
    t_fill(w, 4, f64_from(1));
    t_axpy(v, w, f64_from(2), 4);               # v += 2*w -> [8,8,8,8]
    assert_eq(t_sum(v, 4), f64_from(32), "t_axpy a=2");
    assert(f64_is_finite(f64_from(1)) == 1, "finite ok");

    # ---- linear: analytic backward vs central finite differences ----
    test_group("linear grad-check");
    var M = 3; var K = 4; var N = 5;
    var x = t_alloc(M * K); var W = t_alloc(K * N); var b = t_alloc(N);
    var y = t_alloc(M * N); var dy = t_alloc(M * N);
    t_randn(x, M * K, f64_from(1)); t_randn(W, K * N, f64_from(1));
    t_randn(b, N, f64_from(1)); t_randn(dy, M * N, f64_from(1));
    var dx = t_alloc(M * K); var dW = t_alloc(K * N); var db = t_alloc(N);
    linear_fwd(x, W, b, y, M, K, N);
    linear_bwd(x, W, dy, dx, dW, db, M, K, N);

    var eps = _eps(); var te = f64_mul(f64_from(2), eps);
    var ndx = t_alloc(M * K); var i = 0;
    while (i < M * K) {
        var o = load64(x + i * 8);
        store64(x + i * 8, f64_add(o, eps)); var lp = lin_loss(x, W, b, y, dy, M, K, N);
        store64(x + i * 8, f64_sub(o, eps)); var lm = lin_loss(x, W, b, y, dy, M, K, N);
        store64(x + i * 8, o); store64(ndx + i * 8, f64_div(f64_sub(lp, lm), te)); i = i + 1;
    }
    var ndW = t_alloc(K * N); i = 0;
    while (i < K * N) {
        var o = load64(W + i * 8);
        store64(W + i * 8, f64_add(o, eps)); var lp = lin_loss(x, W, b, y, dy, M, K, N);
        store64(W + i * 8, f64_sub(o, eps)); var lm = lin_loss(x, W, b, y, dy, M, K, N);
        store64(W + i * 8, o); store64(ndW + i * 8, f64_div(f64_sub(lp, lm), te)); i = i + 1;
    }
    var ndb = t_alloc(N); i = 0;
    while (i < N) {
        var o = load64(b + i * 8);
        store64(b + i * 8, f64_add(o, eps)); var lp = lin_loss(x, W, b, y, dy, M, K, N);
        store64(b + i * 8, f64_sub(o, eps)); var lm = lin_loss(x, W, b, y, dy, M, K, N);
        store64(b + i * 8, o); store64(ndb + i * 8, f64_div(f64_sub(lp, lm), te)); i = i + 1;
    }
    check("linear dx", dx, ndx, M * K, 100000);   # rel err < 1e-5
    check("linear dW", dW, ndW, K * N, 100000);
    check("linear db", db, ndb, N, 100000);

    # ---- conv2d/conv1d: known answers + FD gates across configurations ----
    test_group("conv known-answer");
    # 1x1 kernel, weight 2, bias 1: y = 2x + 1 exactly
    var cx = t_alloc(4);                         # N=1 Cin=1 H=2 W=2
    t_fill(cx, 4, f64_from(3));
    var cw = t_alloc(1); store64(cw, f64_from(2));
    var cb = t_alloc(1); store64(cb, f64_from(1));
    var cy = t_alloc(4);
    conv2d_fwd(cx, cw, cb, cy, 1, 1, 2, 2, 1, 1, 1, 1, 1, 0, 0);
    assert(cy != 0, "conv fwd ran");
    assert_eq(load64(cy), f64_from(7), "1x1 conv: y = 2*3 + 1");
    assert_eq(t_sum(cy, 4), f64_from(28), "1x1 conv: all four outputs");
    # 2x2 all-ones kernel on all-ones 3x3 input, no pad: each output = 4
    var sx = t_alloc(9); t_fill(sx, 9, f64_from(1));
    var sw = t_alloc(4); t_fill(sw, 4, f64_from(1));
    var sy = t_alloc(4);
    conv2d_fwd(sx, sw, 0, sy, 1, 1, 3, 3, 1, 2, 2, 1, 1, 0, 0);
    assert_eq(t_sum(sy, 4), f64_from(16), "2x2 sum kernel: 4 outputs of 4");
    # padding: same 2x2 kernel with P=1 -> OH=OW=4; corners see 1 input cell
    var py = t_alloc(16);
    conv2d_fwd(sx, sw, 0, py, 1, 1, 3, 3, 1, 2, 2, 1, 1, 1, 1);
    assert_eq(load64(py), f64_from(1), "padded corner sees one cell");
    assert_eq(t_sum(py, 16), f64_from(36), "padded conv total = 9 cells x 4 taps");

    test_group("conv grad-check");
    conv_fd_case("conv 3x3", 2, 2, 5, 5, 3, 3, 3, 1, 1, 0, 0);
    conv_fd_case("conv strided+padded", 1, 2, 6, 7, 2, 3, 2, 2, 2, 1, 1);
    conv_fd_case("conv nonsquare 1xK", 1, 1, 1, 9, 2, 1, 3, 1, 2, 0, 1);

    test_group("conv1d wrapper parity");
    # conv1d must be bit-identical to conv2d with H=KH=1 (same code path)
    var l1x = t_alloc(8); t_randn(l1x, 8, f64_from(1));      # N=1 Cin=1 L=8
    var l1w = t_alloc(3); t_randn(l1w, 3, f64_from(1));      # K=3
    var OL = conv2d_out_dim(8, 3, 2, 1);
    var y1 = t_alloc(OL); var y2 = t_alloc(OL);
    conv1d_fwd(l1x, l1w, 0, y1, 1, 1, 8, 1, 3, 2, 1);
    conv2d_fwd(l1x, l1w, 0, y2, 1, 1, 1, 8, 1, 1, 3, 1, 2, 0, 1);
    var pd = 0; var pi = 0;
    while (pi < OL) { if (load64(y1 + pi * 8) != load64(y2 + pi * 8)) { pd = pd + 1; } pi = pi + 1; }
    assert(pd == 0, "conv1d == conv2d(H=1) bit-identical");
    # and the backward wrapper (conv1d_bwd had no test before 1.2.2)
    var l1dy = t_alloc(OL); t_randn(l1dy, OL, f64_from(1));
    var a_dx = t_alloc(8); var a_dw = t_alloc(3); var a_db = t_alloc(1);
    var b_dx = t_alloc(8); var b_dw = t_alloc(3); var b_db = t_alloc(1);
    conv1d_bwd(l1x, l1w, l1dy, a_dx, a_dw, a_db, 1, 1, 8, 1, 3, 2, 1);
    conv2d_bwd(l1x, l1w, l1dy, b_dx, b_dw, b_db, 1, 1, 1, 8, 1, 1, 3, 1, 2, 0, 1);
    assert((bits_diff(a_dx, b_dx, 8) + bits_diff(a_dw, b_dw, 3) + bits_diff(a_db, b_db, 1)) == 0,
      "conv1d_bwd == conv2d_bwd(H=1) bit-identical");

    test_group("tensor storage");
    var z0 = t_alloc(0); var z1 = t_alloc(0);
    assert(z0 != 0, "t_alloc(0) is a valid pointer (it exited before 1.2.2)");
    assert(z0 != z1, "t_alloc(0) pointers are distinct");
    assert_eq(load64(z0), 0, "t_alloc(0) slot is zeroed");
    var st = t_alloc(5);
    tset(st, 3, ff(9));
    assert_eq(tget(st, 3), f64_from(9), "tset / tget round-trip");
    assert_eq(tget(st, 2), 0, "t_alloc zero-fills");
    t_fill(st, 5, ff(4));
    assert_eq(t_sum(st, 5), f64_from(20), "t_fill");
    var st2 = t_alloc(6); t_fill(st2, 6, ff(7));
    t_copy(st2, st, 5);
    assert_eq(t_sum(st2, 6), f64_from(27), "t_copy copies n, not n+1");
    t_zero(st2, 5);
    assert_eq(t_sum(st2, 6), f64_from(7), "t_zero zeroes n, not n+1");

    test_group("BLAS-1 packed body + odd tail");
    blas1_case(7); blas1_case(8); blas1_case(1); blas1_case(0);

    test_group("linear vs reference");
    linear_ref_case("3x5x7", 3, 5, 7, 1);
    linear_ref_case("2x6x8", 2, 6, 8, 1);
    linear_ref_case("1x1x1", 1, 1, 1, 1);
    linear_ref_case("2x9x13", 2, 9, 13, 1);
    linear_ref_case("4x0x5 (K = 0: y = b)", 4, 0, 5, 1);
    linear_ref_case("3x4x6 no bias", 3, 4, 6, 0);

    test_group("linear: the AVX2 and SSE2 paths agree (1.4.1)");
    # the default run above takes the AVX2 path on an AVX2 CPU; force SSE2 and
    # repeat, then compare the two paths directly, bit for bit
    _rosnet_force_sse2 = 1;
    linear_ref_case("SSE2: 3x5x7", 3, 5, 7, 1);
    linear_ref_case("SSE2: 2x9x13", 2, 9, 13, 1);
    linear_ref_case("SSE2: 4x0x5", 4, 0, 5, 1);
    blas1_case(7); blas1_case(8); blas1_case(13);   # t_add_into / t_scale on SSE2
    _rosnet_force_sse2 = 0;
    blas1_case(13); blas1_case(14); blas1_case(3);  # ... and on the 4-lane path's tails
    paths_case("paths agree 4x16x300 (3 broadcast chunks)", 4, 16, 300);
    paths_case("paths agree 3x7x771 (odd tail)", 3, 7, 771);
    paths_case("paths agree 2x5x128 (exactly one chunk)", 2, 5, 128);
    paths_case("paths agree 3x6x4 (one 4-lane group)", 3, 6, 4);

    test_group("conv fast paths vs 1.2.1 loops");
    conv_ref_case("3x3 pad 1", 2, 3, 6, 7, 4, 3, 3, 1, 1, 1, 1, 1);
    conv_ref_case("row of 300 (3 chunks)", 1, 2, 2, 300, 2, 1, 3, 1, 1, 0, 1, 1);
    conv_ref_case("row of 257, kernel 5", 1, 1, 3, 257, 2, 3, 5, 2, 1, 1, 2, 1);
    conv_ref_case("pad > kernel", 1, 2, 3, 3, 2, 2, 2, 1, 1, 3, 3, 1);
    conv_ref_case("input smaller than kernel", 2, 2, 2, 3, 2, 3, 3, 1, 1, 1, 1, 1);
    conv_ref_case("strided SW = 2 (general path)", 1, 2, 7, 9, 3, 3, 2, 2, 2, 1, 0, 1);
    conv_ref_case("no bias, no dx, no db", 1, 3, 5, 6, 2, 2, 3, 1, 1, 0, 1, 0);

    return assert_summary();
}

# t_scale / t_add_into at length n: integer-valued, so the expected bits are exact.
fn blas1_case(n): i64 {
    var a = t_alloc(n); var b = t_alloc(n);
    var i = 0;
    while (i < n) { tset(a, i, ff(i + 1)); tset(b, i, ff(2 * i)); i = i + 1; }
    t_add_into(a, b, n);            # a[i] = 3i + 1
    t_scale(a, n, ff(2));           # a[i] = 6i + 2
    var bad = 0;
    i = 0;
    while (i < n) { if (tget(a, i) != ff(6 * i + 2)) { bad = bad + 1; } i = i + 1; }
    assert(bad == 0, "t_add_into + t_scale exact over every element");
    return 0;
}

# linear_fwd and linear_bwd's dW / db against the scalar oracle. Bit-identical
# where the packed multiply-add rounds twice (x86_64); within 1e-12 elsewhere.
fn linear_ref_case(name, M, K, N, with_bias): i64 {
    var x = t_alloc(M * K); var W = t_alloc(K * N); var dy = t_alloc(M * N);
    t_randn(x, M * K, f64_from(1)); t_randn(W, K * N, f64_from(1)); t_randn(dy, M * N, f64_from(1));
    var b = 0;
    if (with_bias == 1) { b = t_alloc(N); t_randn(b, N, f64_from(1)); }
    var y = t_alloc(M * N); var ry = t_alloc(M * N);
    linear_fwd(x, W, b, y, M, K, N);
    ref_linear_fwd(x, W, b, ry, M, K, N);
    var dx = t_alloc(M * K); var dW = t_alloc(K * N); var rdW = t_alloc(K * N);
    var db = 0; var rdb = 0;
    if (with_bias == 1) { db = t_alloc(N); rdb = t_alloc(N); }
    linear_bwd(x, W, dy, dx, dW, db, M, K, N);
    ref_linear_bwd_params(x, dy, rdW, rdb, M, K, N);
    var nb = 0;
    if (with_bias == 1) { nb = N; }
    if (_packed_fma_exact() == 1) {
        assert((bits_diff(y, ry, M * N) + bits_diff(dW, rdW, K * N)) == 0, name);
    } else {
        var tol = f64_div(f64_from(1), f64_from(1000000000000));
        assert(f64_gt(max_relerr(y, ry, M * N), tol) == 0, name);
        assert(f64_gt(max_relerr(dW, rdW, K * N), tol) == 0, name);
    }
    if (with_bias == 1) { assert(bits_diff(db, rdb, nb) == 0, name); }
    return 0;
}

# linear_fwd / linear_bwd under the default path and under forced SSE2: every
# output bit-identical (on aarch64 both runs take the SSE2 path).
fn paths_case(name, M, K, N): i64 {
    var x = t_alloc(M * K); var W = t_alloc(K * N); var b = t_alloc(N); var dy = t_alloc(M * N);
    t_randn(x, M * K, f64_from(1)); t_randn(W, K * N, f64_from(1));
    t_randn(b, N, f64_from(1)); t_randn(dy, M * N, f64_from(1));
    var y1 = t_alloc(M * N); var y2 = t_alloc(M * N);
    var dx1 = t_alloc(M * K); var dx2 = t_alloc(M * K);
    var dW1 = t_alloc(K * N); var dW2 = t_alloc(K * N); var db1 = t_alloc(N); var db2 = t_alloc(N);
    linear_fwd(x, W, b, y1, M, K, N);
    linear_bwd(x, W, dy, dx1, dW1, db1, M, K, N);
    _rosnet_force_sse2 = 1;
    linear_fwd(x, W, b, y2, M, K, N);
    linear_bwd(x, W, dy, dx2, dW2, db2, M, K, N);
    _rosnet_force_sse2 = 0;
    var d = bits_diff(y1, y2, M * N) + bits_diff(dx1, dx2, M * K);
    d = d + bits_diff(dW1, dW2, K * N) + bits_diff(db1, db2, N);
    assert(d == 0, name);
    return 0;
}

# conv2d_fwd / conv2d_bwd against the 1.2.1 loops (tests/reference.cyr): the
# 1.2.2 kernels add into every output in the same order, so bit-identical on
# every target. full = 0 passes b = 0, dx = 0, db = 0.
fn conv_ref_case(name, N, Cin, H, W, Cout, KH, KW, SH, SW, PH, PW, full): i64 {
    var OH = conv2d_out_dim(H, KH, SH, PH); var OW = conv2d_out_dim(W, KW, SW, PW);
    var nx = N * Cin * H * W; var nw = Cout * Cin * KH * KW; var ny = N * Cout * OH * OW;
    var x = t_alloc(nx); var Wf = t_alloc(nw); var dy = t_alloc(ny);
    t_randn(x, nx, f64_from(1)); t_randn(Wf, nw, f64_from(1)); t_randn(dy, ny, f64_from(1));
    var b = 0; var dx = 0; var rdx = 0; var db = 0; var rdb = 0;
    if (full == 1) {
        b = t_alloc(Cout); t_randn(b, Cout, f64_from(1));
        dx = t_alloc(nx); rdx = t_alloc(nx); db = t_alloc(Cout); rdb = t_alloc(Cout);
    }
    var y = t_alloc(ny); var ry = t_alloc(ny);
    conv2d_fwd(x, Wf, b, y, N, Cin, H, W, Cout, KH, KW, SH, SW, PH, PW);
    ref_conv2d_fwd(x, Wf, b, ry, N, Cin, H, W, Cout, KH, KW, SH, SW, PH, PW);
    var dW = t_alloc(nw); var rdW = t_alloc(nw);
    t_randn(dW, nw, f64_from(1)); t_copy(rdW, dW, nw);      # dW accumulates
    conv2d_bwd(x, Wf, dy, dx, dW, db, N, Cin, H, W, Cout, KH, KW, SH, SW, PH, PW);
    ref_conv2d_bwd(x, Wf, dy, rdx, rdW, rdb, N, Cin, H, W, Cout, KH, KW, SH, SW, PH, PW);
    var d = bits_diff(y, ry, ny) + bits_diff(dW, rdW, nw);
    if (full == 1) { d = d + bits_diff(dx, rdx, nx) + bits_diff(db, rdb, Cout); }
    assert(d == 0, name);
    return 0;
}

var exit_code = main();
syscall(SYS_EXIT, exit_code);
